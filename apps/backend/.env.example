# AegisSOC Backend Environment Configuration
# Copy this file to .env for local development


# Application
APP_NAME=AegisSOC Backend
APP_VERSION=1.0.0
APP_ENV=development


# API
API_HOST=127.0.0.1
API_PORT=8000


# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aegissoc
DATABASE_USER=aegissoc_user
DATABASE_PASSWORD=CHANGE_ME


# Security
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30


# Logging
LOG_LEVEL=INFO